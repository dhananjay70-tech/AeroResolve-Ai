PORT=5000
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
PUBLIC_BASE_URL=http://localhost:5000

# Exotel voice provider (India-only outbound supervisor calling).
# Optional: if left blank, supervisor calling reports "not configured" and
# the rest of the app (including escalations) keeps working normally.
EXOTEL_ACCOUNT_SID=your_exotel_account_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_CALLER_ID=your_exotel_phone_number
SUPERVISOR_PHONE_NUMBER=+91XXXXXXXXXX
# API host for your Exotel account's region, e.g. https://api.exotel.com
# (Singapore) or https://api.in.exotel.com (Mumbai).
EXOTEL_API_BASE_URL=https://api.in.exotel.com
# App Bazaar flow (ExoML) id that plays the case summary to the supervisor.
EXOTEL_FLOW_APP_ID=
EXOTEL_WEBHOOK_TOKEN=
