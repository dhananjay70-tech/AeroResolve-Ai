PORT=8000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Dedicated Node backend account this service logs in as to call protected
# APIs (customers/bookings/agent/escalations). It is auto-registered on the
# Node backend the first time it logs in and fails.
BACKEND_SERVICE_EMAIL=ai-service@aeroresolve.internal
BACKEND_SERVICE_PASSWORD=
BACKEND_SERVICE_NAME=AeroResolve AI Service
